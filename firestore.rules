rules_version = '2';

// Firestore Rules cho RCA Tracking App — dán vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Chủ dự án (Google) luôn là Admin, không cần hồ sơ trong rca_users.
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'dangthanhbinh53@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/rca_users/$(request.auth.uid);
    }

    function activeProfile() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    function role() {
      return get(profilePath()).data.role;
    }

    // Mọi tài khoản đang hoạt động (kể cả mật khẩu chung "chỉ xem").
    function isMember() {
      return isOwner() || activeProfile();
    }

    // Leader + Admin: được thêm/sửa RCA và Action.
    // (Việc Leader chỉ sửa RCA có tên mình do app kiểm tra ở giao diện.)
    function isEditor() {
      return isOwner() || (activeProfile() && role() in ['leader', 'admin']);
    }

    function isAdmin() {
      return isOwner() || (activeProfile() && role() == 'admin');
    }

    match /rca_records/{id} {
      allow read: if isMember();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /rca_actions/{id} {
      allow read: if isMember();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Cài đặt / danh mục (Function, Dept, Category, hạn xử lý...): chỉ Admin ghi.
    match /rca_meta/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Hồ sơ & vai trò tài khoản: mỗi người đọc được hồ sơ của mình; chỉ Admin liệt kê/tạo/sửa/xoá.
    match /rca_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['viewer', 'leader', 'admin']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
  }
}
